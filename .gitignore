# ==============================================================================
# SteelGuardian (스틸가디언) .gitignore
# ==============================================================================

# 1. 시연 영상: 공식 제출 비디오만 허용하고 기타 임시 비디오 제외
*.mp4
!SteelGuardian_Demo_Video.mp4
!docs/demo/SteelGuardian_Demo_Video.mp4
*.avi
*.mov

# 2. Python 가상환경 및 캐시
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 3. GitHub 100MB 파일 크기 제한 초과 파일 제외
wheels/
role_packages/
*.zip
*.whl

# 4. 임시/로그 파일
logs/*.tmp
logs/*_temp.csv
.system_generated/
*.bak

# 5. OS 및 IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
