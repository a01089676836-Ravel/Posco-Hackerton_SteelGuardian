# POSCO Smart Factory AI Defect Inspection Configuration (.env.example)
# 기본값: 단일 PC 로컬 보안 격리 (외부 네트워크 직접 접근 차단)
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Streamlit 대시보드 -> FastAPI 백엔드 통신 기본 URL
API_BASE_URL=http://127.0.0.1:8000

# 원격 네트워크(타 노트북/태블릿)에서의 모델 핫스왑 활성화 허용 여부 (0: 차단, 1: 허용)
ALLOW_REMOTE_ACTIVATION=0

# 관리자 인증 키 (원격 활성화 시 필수, 코드 내 하드코딩 금지)
# ADMIN_API_KEY=your-secure-admin-api-key-here

# 운영 모드 및 안전 정책
ALLOW_MOCK=0
DEFAULT_CAMERA_ID=CAM_FINISHING_01
DEFAULT_OPERATING_MODE=SAFETY_FIRST
