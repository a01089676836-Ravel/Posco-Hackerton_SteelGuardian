# POSCO Smart Factory AI Defect Inspection Configuration (.env.demo_lan.example)
# 다기기(동일 Wi-Fi/LAN 타 노트북·태블릿·심사위원 PC) 시연용 설정 예시
# 사용 방법: copy .env.demo_lan.example .env 후 IP 및 키를 수정하여 사용하십시오.

# 모든 네트워크 인터페이스 바인딩 (외부 기기 접속 허용)
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Streamlit -> FastAPI 통신 URL (로컬 머신에서는 127.0.0.1, 외부 머신에서는 서버 LAN IP 지정)
API_BASE_URL=http://127.0.0.1:8000

# 원격 네트워크(타 노트북/태블릿)에서의 모델 핫스왑 활성화 허용 여부 (1: 허용)
ALLOW_REMOTE_ACTIVATION=1

# 원격 활성화 필수 관리자 인증 키 (x-admin-key 헤더에 포함하여 호출)
# 시연마다 새로 생성해 아래 줄의 주석을 풀고 입력하십시오. 미설정 시 원격 활성화는 차단됩니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# 운영 모드 및 안전 정책
ALLOW_MOCK=0
DEFAULT_CAMERA_ID=CAM_FINISHING_01
DEFAULT_OPERATING_MODE=SAFETY_FIRST
